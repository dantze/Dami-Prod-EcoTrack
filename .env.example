# =========================================================================
# EcoTrack LOCAL stack environment (.env)
# Copy this file to .env and fill in DB_PASS; the rest have usable defaults.
#
# Read by docker-compose.yml, which since TODO-91 is Postgres + the backend and
# nothing else — the SPA runs from `npm run dev`. It is not deployed anywhere:
# production is Cloud Run + Cloud SQL + Vercel, described in infra/ and applied
# by .github/workflows/deploy.yml.
#
# So the values here no longer have to be real production ones. Where a name
# also exists in production, it arrives from a different place:
#
#   DB_HOST/PORT/NAME/USER   Cloud Run env, set by infra/main.tf
#   DB_PASS                  Secret Manager, generated by Terraform
#   GCS_BUCKET               Cloud Run env, set by infra/main.tf - no key
#   ECOTRACK_CORS_*          computed by infra/main.tf from the Vercel domain
# =========================================================================

# --- Database (PostgreSQL) Configuration ---
DB_NAME=damiprod
DB_USER=damiprod_user
DB_PASS=replace_with_strong_password_here
DB_PORT=5432

# --- Task photo storage (Google Cloud Storage) ---
# There is no key here and there is not meant to be one: the backend
# authenticates as the Cloud Run runtime service account through Application
# Default Credentials (TODO-79). Leave this EMPTY for a local run and photo
# upload is the only thing that will not work. To exercise it locally, point it
# at a real bucket and give the container ADC:
#   gcloud auth application-default login
GCS_BUCKET=

# --- Security & Auth Enforcement ---
# Set to 'true' to enforce Bearer token authentication and Role-Based Access Control on all /api/** endpoints.
ECOTRACK_SECURITY_ENFORCE=true

# Allowed CORS origins for browser web clients (comma-separated).
# Example: https://app.ecotrack.ro,http://localhost:5173
ECOTRACK_CORS_ALLOWED_ORIGINS=https://app.ecotrack.ro,http://localhost:5173

# --- First-run admin code (optional) ---
# The code the very first access request must carry to claim this instance as
# ADMIN. Leave it EMPTY and the backend generates one and prints it to its own
# log, which means SSH + `docker compose logs backend` before anyone can enrol.
# Set it and whoever deploys already knows it, so a non-technical person can do
# the first enrolment.
#
# Must be at least 12 characters or it is ignored with an error. Generate it:
#   openssl rand -base64 18
# Inert the moment one employee exists, and NOT accepted for admin-lockout
# recovery - that code is always generated and always read from the log.
ECOTRACK_SETUP_CODE=

